{
  "name": "HackTheBox Hacker",
  "colors": {
    "primary": "#9fef00",
    "secondary": "#a4b816",
    "accent": "#2ecc71",
    "background": "#0a0e0f",
    "foreground": "#9fef00",
    "muted": "#111b1d",
    "border": "#1e3a29",
    "card": "#0d1416",
    "popover": "#111b1d",
    "destructive": "#e74c3c",
    "warning": "#f39c12",
    "success": "#9fef00",
    "textPrimary": "#9fef00",
    "textSecondary": "#a4b816",
    "textMuted": "#6c8f3f",
    "textAccent": "#2ecc71",
    "textInverse": "#0a0e0f"
  },
  "typography": {
    "fontFamily": "\"Courier New\", \"Ubuntu Mono\", \"Fira Code\", monospace",
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem",
      "6xl": "3.75rem"
    },
    "fontWeight": {
      "light": "300",
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700",
      "extrabold": "800"
    }
  },
  "layout": {
    "borderRadius": "0.25rem",
    "spacing": {
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "2xl": "3rem"
    },
    "shadows": {
      "sm": "0 1px 2px 0 rgba(159, 239, 0, 0.1)",
      "md": "0 4px 6px -1px rgba(159, 239, 0, 0.15)",
      "lg": "0 10px 15px -3px rgba(159, 239, 0, 0.2)",
      "xl": "0 20px 25px -5px rgba(159, 239, 0, 0.25)"
    }
  },
  "components": {
    "button": {
      "style": "default",
      "size": "md",
      "rounded": false
    },
    "card": {
      "style": "default",
      "border": true,
      "shadow": true
    },
    "input": {
      "style": "default",
      "border": true
    }
  },
  "animations": {
    "enabled": true,
    "duration": "fast",
    "easing": "linear"
  },
  "effects": {
    "backgroundParticles": true,
    "glowEffects": true,
    "glassmorphism": false,
    "neonBorders": true,
    "gradientBackgrounds": false,
    "animatedElements": true,
    "hoverEffects": true,
    "scrollAnimations": true
  },
  "customCSS": "/* HackTheBox terminal styling */\n.htb-terminal {\n  font-family: \"Courier New\", monospace;\n  text-shadow: 0 0 5px rgba(159, 239, 0, 0.5);\n}\n\n/* Cursor blink effect */\n@keyframes htb-blink {\n  0%, 50% { opacity: 1; }\n  51%, 100% { opacity: 0; }\n}\n\n.htb-cursor::after {\n  content: \"█\";\n  animation: htb-blink 1s step-end infinite;\n  color: #9fef00;\n}\n\n/* Scanline effect */\n@keyframes htb-scanline {\n  0% { transform: translateY(-100%); }\n  100% { transform: translateY(100%); }\n}\n\n.htb-scanline::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 2px;\n  background: linear-gradient(transparent, rgba(159, 239, 0, 0.3), transparent);\n  animation: htb-scanline 8s linear infinite;\n  pointer-events: none;\n}",
  "version": 1
}
