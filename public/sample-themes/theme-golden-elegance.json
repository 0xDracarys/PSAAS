{
  "name": "Golden Elegance",
  "colors": {
    "primary": "#d97706",
    "secondary": "#b45309",
    "accent": "#fbbf24",
    "background": "#fffbeb",
    "foreground": "#78350f",
    "muted": "#fef3c7",
    "border": "#fcd34d",
    "card": "#ffffff",
    "popover": "#ffffff",
    "destructive": "#dc2626",
    "warning": "#f59e0b",
    "success": "#059669",
    "textPrimary": "#78350f",
    "textSecondary": "#92400e",
    "textMuted": "#b45309",
    "textAccent": "#d97706",
    "textInverse": "#fffbeb"
  },
  "typography": {
    "fontFamily": "'Cormorant Garamond', 'Playfair Display', serif",
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem",
      "6xl": "3.75rem"
    },
    "fontWeight": {
      "light": "300",
      "normal": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700",
      "extrabold": "800"
    }
  },
  "layout": {
    "borderRadius": "0.125rem",
    "spacing": {
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "2xl": "3rem"
    },
    "shadows": {
      "sm": "0 2px 4px 0 rgba(217, 119, 6, 0.08)",
      "md": "0 6px 12px -2px rgba(217, 119, 6, 0.12)",
      "lg": "0 12px 24px -6px rgba(217, 119, 6, 0.16)",
      "xl": "0 24px 48px -12px rgba(217, 119, 6, 0.2)"
    }
  },
  "components": {
    "button": {
      "style": "default",
      "size": "md",
      "rounded": false
    },
    "card": {
      "style": "minimal",
      "border": true,
      "shadow": true
    },
    "input": {
      "style": "minimal",
      "border": true
    }
  },
  "animations": {
    "enabled": true,
    "duration": "slow",
    "easing": "ease-in-out"
  },
  "effects": {
    "backgroundParticles": false,
    "glowEffects": true,
    "glassmorphism": false,
    "neonBorders": false,
    "gradientBackgrounds": false,
    "animatedElements": false,
    "hoverEffects": true,
    "scrollAnimations": false
  },
  "customCSS": "/* Elegant decorative elements */\n.elegant-border::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 2px;\n  background: linear-gradient(90deg, transparent, #d97706, transparent);\n}",
  "version": 1
}
